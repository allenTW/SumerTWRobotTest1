<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.allentw.claude-monitor</string>

  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>/Volumes/FCP 512GB/Claude/SumerTWRobotTest1/tools/claude_monitor.py</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- launchd 不會載入 shell 設定，git 的位置要自己給 -->
    <key>PATH</key>
    <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin</string>
    <!-- minimal / standard / verbose；verbose 會把對話摘錄發佈到公開網頁 -->
    <key>CLAUDE_MONITOR_DETAIL</key>
    <string>standard</string>
  </dict>

  <key>StartInterval</key>
  <integer>60</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/haungshihpo/Library/Logs/claude-monitor.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/haungshihpo/Library/Logs/claude-monitor.log</string>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
